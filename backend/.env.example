# Copy to .env and fill in. .env is gitignored — never commit real credentials.

ENVIRONMENT=development

# --- Supabase Postgres ---
# Both URLs come from: Supabase Dashboard > Project Settings > Database.
#
# DATABASE_URL = DIRECT connection (port 5432). Used by Alembic migrations.
#   Dashboard > "Connection string" > URI.
#   NOTE: Supabase serves the direct host over IPv6. If your network has no IPv6
#   and this won't connect, use the SESSION-mode pooler string instead (pooler
#   host, port 5432) — it behaves like a direct connection over IPv4.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# DATABASE_POOL_URL = POOLER, transaction mode (port 6543). Used by the app at runtime.
#   Dashboard > "Connection pooling" > Transaction mode. Omit to fall back to DATABASE_URL.
DATABASE_POOL_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- AI / agent (Phase 1) ---
# Google Gemini API key — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-2.0-flash
# PROMPT_VERSION=v1

# --- Observability: Langfuse (Phase 1) ---
# Free "Hobby" tier at https://cloud.langfuse.com — create a project, then copy both keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com   # use https://us.cloud.langfuse.com for the US region
